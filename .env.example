# Copy to .env (git-ignored). SEC requires a name and contact email in the User-Agent
# of every request, or it answers HTTP 403. https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional: folder where you downloaded companyfacts.zip and submissions.zip (from SEC) and/or
# stock_prices.parquet (from https://huggingface.co/datasets/defeatbeta/yahoo-finance-data/tree/main/data/US).
# When set, the script reads those instead of downloading, and never deletes them.
# WSL example: SEC_ZIP_DIR="/mnt/c/Users/You/Downloads"
# SEC_ZIP_DIR=""
